From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MultiFolia <no-reply@github.com>
Date: Sun, 13 Sep 2026 12:01:00 -0600
Subject: [PATCH] Add MultiFolia management command

Register the native MultiFolia management command and its /mf alias. The
command is intentionally observational: it reports the local control-plane
state and does not bypass Folia's region scheduler or ownership checks.

diff --git a/src/main/java/io/papermc/paper/command/PaperCommands.java b/src/main/java/io/papermc/paper/command/PaperCommands.java
index 6216147f4d4c04ba616375430a91232d5ebe838a..f2f30e9139a41da1bd4494f39dcc4938e3a0ca04 100644
--- a/src/main/java/io/papermc/paper/command/PaperCommands.java
+++ b/src/main/java/io/papermc/paper/command/PaperCommands.java
@@ -23,4 +23,5 @@ public final class PaperCommands {
     public static void registerCommands(final MinecraftServer server) {
         COMMANDS.put("paper", new PaperCommand("paper"));
+        COMMANDS.put("multifolia", new dev.multifolia.MultiFoliaCommand()); // MultiFolia - management command
         COMMANDS.put("tps", new io.papermc.paper.threadedregions.commands.CommandServerHealth()); // Folia - region threading
         COMMANDS.put("profiler", new io.papermc.paper.threadedregions.commands.CommandProfiler()); // Folia - region threading - profiler
 

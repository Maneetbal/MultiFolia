diff --git a/src/main/java/io/papermc/paper/command/brigadier/bukkit/BukkitCommandNode.java b/src/main/java/io/papermc/paper/command/brigadier/bukkit/BukkitCommandNode.java
index 5c52b1563d20d7e977a5bb958c18b19dec5c365a..fd21fcd3012dea417c571e675a8c38781ccd3087 100644
--- a/src/main/java/io/papermc/paper/command/brigadier/bukkit/BukkitCommandNode.java
+++ b/src/main/java/io/papermc/paper/command/brigadier/bukkit/BukkitCommandNode.java
@@ -105,6 +105,10 @@ public class BukkitCommandNode extends LiteralCommandNode<CommandSourceStack> {
 
             List<String> results = null;
             Location pos = context.getSource().getLocation();
+            // MultiPaper start - Add MultiPaper API
+            try {
+                ((org.bukkit.craftbukkit.CraftServer) sender.getServer()).inTabCompletion.set(true);
+            // MultiPaper end - Add MultiPaper API
             try {
                 results = this.command.tabComplete(sender, this.literal, args, pos.clone());
             } catch (CommandException ex) {
@@ -121,6 +125,12 @@ public class BukkitCommandNode extends LiteralCommandNode<CommandSourceStack> {
                 }
             }
             // Paper end
+            // MultiPaper start - Add MultiPaper API
+            } finally {
+                ((org.bukkit.craftbukkit.CraftServer) sender.getServer()).inTabCompletion.remove();
+            }
+            // MultiPaper end - Add MultiPaper API
+
             if (results == null) {
                 return builder.buildFuture();
             }

         return new CraftInput(this.getHandle().getLastClientInput());
     }
 
+    // MultiPaper start - Add MultiPaper API
+    @Override
+    public boolean isInExternalChunk() {
+        return false;
+    }
+
+    @Override
+    public boolean isInLocalChunk() {
+        return false;
+    }
+
+    @Override
+    public boolean isExternalPlayer() {
+        return puregero.multipaper.MultiPaper.isExternalPlayer(this);
+    }
+
+    @Override
+    public boolean isLocalPlayer() {
+        return puregero.multipaper.MultiPaper.isRealPlayer(this);
+    }
+
+    @Override
+    public String getData(String key) {
+        return this.data.get(key);
+    }
+
+    @Override
+    public void setData(String key, String value) {
+        if (value != null) {
+            this.data.put(key, value);
+        } else {
+            this.data.remove(key);
+        }
+        puregero.multipaper.MultiPaper.broadcastPacketToExternalServers(this.getHandle(), new puregero.multipaper.externalserverprotocol.PlayerDataUpdatePacket(this.getUniqueId(), false, key, value));
+    }
+
+    @Override
+    public String getPersistentData(String key) {
+        return this.persistentData.get(key);
+    }
+
+    @Override
+    public void setPersistentData(String key, String value) {
+        if (value != null) {
+            this.persistentData.put(key, value);
+        } else {
+            this.persistentData.remove(key);
+        }
+        puregero.multipaper.MultiPaper.broadcastPacketToExternalServers(this.getHandle(), new puregero.multipaper.externalserverprotocol.PlayerDataUpdatePacket(this.getUniqueId(), true, key, value));
+    }
+
+    @Override
+    public void chatOnOtherServers(@NonNull String msg) {
+        puregero.multipaper.MultiPaper.broadcastPacketToExternalServers(this.getHandle(), new puregero.multipaper.externalserverprotocol.PlayerSayChatPacket(this.getUniqueId(), msg));
+    }
+
+    @Override
+    public String getExternalServerName() {
+        return this.getHandle() instanceof puregero.multipaper.ExternalPlayer externalPlayer ? externalPlayer.externalServerConnection.externalServer.getName() : null;
+    }
+    // MultiPaper end - Add MultiPaper API
+

@@ -672,6 +681,24 @@ public final class CraftServer implements Server {
 
     @Override
     public List<CraftPlayer> getOnlinePlayers() {
+        // MultiPaper start - Add MultiPaper API
+        // if we're tab-completing, we probably want all the players
+        // instead of just the ones on our server.
+        if (this.inTabCompletion.get()) {
+            return this.getAllOnlinePlayers();
+        } else {
+            return this.getLocalOnlinePlayers();
+        }
+    }
+
+    @Override
+    public List<CraftPlayer> getLocalOnlinePlayers() {
+        return this.localPlayerView;
+    }
+
+    @Override

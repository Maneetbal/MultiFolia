From: MultiFolia <multifolia@users.noreply.github.com>
Date: Sat, 13 Sep 2026 00:00:00 +0000
Subject: [PATCH] Add MultiFolia management command

diff --git a/src/main/java/io/papermc/paper/command/MultiFoliaCommand.java b/src/main/java/io/papermc/paper/command/MultiFoliaCommand.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/io/papermc/paper/command/MultiFoliaCommand.java
@@ -0,0 +1,42 @@
+package io.papermc.paper.command;
+
+import net.minecraft.server.MinecraftServer;
+import org.bukkit.Bukkit;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import java.util.List;
+
+public final class MultiFoliaCommand extends Command {
+    private static final List<String> SUBCOMMANDS = List.of("servers", "list", "debug", "map");
+    private final MinecraftServer server;
+
+    public MultiFoliaCommand(final String name, final MinecraftServer server) {
+        super(name, "MultiFolia management", "/" + name + " <servers|list|debug|map>", SUBCOMMANDS);
+        this.server = server;
+        this.setPermission("multifolia.admin");
+    }
+
+    @Override
+    public boolean execute(final CommandSender sender, final String label, final String[] args) {
+        if (!this.testPermission(sender)) return true;
+        if (args.length == 0 || args[0].equalsIgnoreCase("help")) {
+            sender.sendMessage("/" + label + " servers|list|debug|map");
+            return true;
+        }
+        switch (args[0].toLowerCase(java.util.Locale.ROOT)) {
+            case "servers" -> sender.sendMessage("MultiFolia worker: " + server.server.getName() + " (local control plane)");
+            case "list" -> sender.sendMessage("Players online: " + Bukkit.getOnlinePlayers().size());
+            case "debug" -> sender.sendMessage("Region debug is observational only; Folia ownership is unchanged.");
+            case "map" -> sender.sendMessage("Region map is observational only; live cross-worker mutation is disabled.");
+            default -> sender.sendMessage("Unknown subcommand. Use /" + label + " servers|list|debug|map");
+        }
+        return true;
+    }
+
+    @Override
+    public List<String> tabComplete(final CommandSender sender, final String alias, final String[] args) {
+        if (args.length > 1) return List.of();
+        String prefix = args.length == 0 ? "" : args[0].toLowerCase(java.util.Locale.ROOT);
+        return SUBCOMMANDS.stream().filter(s -> s.startsWith(prefix)).toList();
+    }
+}
+
diff --git a/src/main/java/io/papermc/paper/command/PaperCommands.java b/src/main/java/io/papermc/paper/command/PaperCommands.java
--- a/src/main/java/io/papermc/paper/command/PaperCommands.java
+++ b/src/main/java/io/papermc/paper/command/PaperCommands.java
@@ -19,6 +19,8 @@ public final class PaperCommands {
 
     public static void registerCommands(final MinecraftServer server) {
         COMMANDS.put("paper", new PaperCommand("paper"));
+        COMMANDS.put("multifolia", new MultiFoliaCommand("multifolia", server));
+        COMMANDS.put("mf", new MultiFoliaCommand("mf", server));
 
         COMMANDS.forEach((s, command) -> {
             server.server.getCommandMap().register(s, "Paper", command);
